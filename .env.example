# Copy to .env.local and fill in. Never put real values in this file — it is committed.

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Clerk → Webhooks → endpoint https://<your-domain>/api/webhooks/clerk → Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Secret key is used only by the Clerk webhook to write the profiles table.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Optional services: leave empty to switch them off.

# Sentry (error monitoring) — sentry.io → Project → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (CI / Vercel only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (rate limiting) — console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (email) — resend.com → API Keys. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM="Next Template <hello@example.com>"
